#!/usr/bin/env sh
set -eu

NANOPREDICT_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
NANOPREDICT_ENV="$NANOPREDICT_ROOT/.nanopredict-env"
NANOPREDICT_PYTHON="$NANOPREDICT_ENV/bin/python"
NANOPREDICT_READY="$NANOPREDICT_ENV/.ready"

if [ ! -x "$NANOPREDICT_PYTHON" ]; then
    echo "First run: creating the private Nanopredict environment..."
    command -v python3 >/dev/null 2>&1 || {
        echo "Python was not found. Install Python 3.9-3.12 and try again." >&2
        exit 1
    }
    python3 -c 'import sys; raise SystemExit(0 if (3, 9) <= sys.version_info[:2] < (3, 13) else 1)' || {
        echo "Nanopredict requires Python 3.9-3.12." >&2
        exit 1
    }
    python3 -m venv "$NANOPREDICT_ENV"
    "$NANOPREDICT_PYTHON" -m pip install --upgrade pip
fi

NANOPREDICT_CONFIG_HASH=$(
    "$NANOPREDICT_PYTHON" -c 'import hashlib,pathlib,sys; print(hashlib.sha256(pathlib.Path(sys.argv[1]).read_bytes()).hexdigest())' "$NANOPREDICT_ROOT/pyproject.toml"
)
NANOPREDICT_READY_HASH=""
if [ -f "$NANOPREDICT_READY" ]; then
    IFS= read -r NANOPREDICT_READY_HASH < "$NANOPREDICT_READY" || true
fi

if [ "$NANOPREDICT_READY_HASH" != "$NANOPREDICT_CONFIG_HASH" ]; then
    echo "Installing or updating Nanopredict..."
    "$NANOPREDICT_PYTHON" -m pip install 'setuptools>=68' wheel
    "$NANOPREDICT_PYTHON" -m pip install --no-build-isolation --editable "$NANOPREDICT_ROOT"
    printf '%s\n' "$NANOPREDICT_CONFIG_HASH" > "$NANOPREDICT_READY"
fi

exec "$NANOPREDICT_PYTHON" -m nanopredict "$@"
